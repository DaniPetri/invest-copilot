{
  "name": "Invest Copilot",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "pip install uv && uv run python scripts/tasks.py setup && uv run python scripts/tasks.py data && uv run python scripts/tasks.py ingest",
  "forwardPorts": [5173, 8000],
  "portsAttributes": { "5173": { "label": "Web", "onAutoForward": "openBrowser" }, "8000": { "label": "API" } },
  "customizations": { "vscode": { "extensions": ["ms-python.python", "charliermarsh.ruff", "bradlc.vscode-tailwindcss"] } }
}
