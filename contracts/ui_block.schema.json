{
  "$defs": {
    "AttributionBlock": {
      "additionalProperties": false,
      "properties": {
        "change_eur": {
          "title": "Change Eur",
          "type": "number"
        },
        "change_pct": {
          "title": "Change Pct",
          "type": "number"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/MarketEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/AttributionRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "type": {
          "const": "attribution",
          "default": "attribution",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "rows",
        "events",
        "change_eur",
        "change_pct"
      ],
      "title": "AttributionBlock",
      "type": "object"
    },
    "AttributionRow": {
      "additionalProperties": false,
      "properties": {
        "contribution_pct": {
          "description": "Share of total portfolio move, in percentage points",
          "title": "Contribution Pct",
          "type": "number"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "pnl_eur": {
          "title": "Pnl Eur",
          "type": "number"
        },
        "pnl_pct": {
          "title": "Pnl Pct",
          "type": "number"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "name",
        "pnl_eur",
        "pnl_pct",
        "contribution_pct"
      ],
      "title": "AttributionRow",
      "type": "object"
    },
    "CitationItem": {
      "additionalProperties": false,
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "product_name": {
          "title": "Product Name",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "snippet": {
          "title": "Snippet",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "product_name",
        "page",
        "section",
        "snippet"
      ],
      "title": "CitationItem",
      "type": "object"
    },
    "CitationsBlock": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/CitationItem"
          },
          "title": "Items",
          "type": "array"
        },
        "type": {
          "const": "citations",
          "default": "citations",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "CitationsBlock",
      "type": "object"
    },
    "CostBreakdownBlock": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/CostRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "total": {
          "title": "Total",
          "type": "number"
        },
        "total_pct_of_contributions": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Pct Of Contributions"
        },
        "type": {
          "const": "cost_breakdown",
          "default": "cost_breakdown",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "rows",
        "total"
      ],
      "title": "CostBreakdownBlock",
      "type": "object"
    },
    "CostRow": {
      "additionalProperties": false,
      "properties": {
        "amount_eur": {
          "minimum": 0,
          "title": "Amount Eur",
          "type": "number"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label",
        "amount_eur"
      ],
      "title": "CostRow",
      "type": "object"
    },
    "ExposureBarsBlock": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "enum": [
            "sector",
            "country",
            "company"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ExposureRow"
          },
          "title": "Rows",
          "type": "array"
        },
        "type": {
          "const": "exposure_bars",
          "default": "exposure_bars",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "rows"
      ],
      "title": "ExposureBarsBlock",
      "type": "object"
    },
    "ExposureRow": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "key",
        "label",
        "weight"
      ],
      "title": "ExposureRow",
      "type": "object"
    },
    "FanChartBlock": {
      "additionalProperties": false,
      "properties": {
        "contributions": {
          "items": {
            "type": "number"
          },
          "title": "Contributions",
          "type": "array"
        },
        "p25": {
          "items": {
            "type": "number"
          },
          "title": "P25",
          "type": "array"
        },
        "p5": {
          "items": {
            "type": "number"
          },
          "title": "P5",
          "type": "array"
        },
        "p50": {
          "items": {
            "type": "number"
          },
          "title": "P50",
          "type": "array"
        },
        "p75": {
          "items": {
            "type": "number"
          },
          "title": "P75",
          "type": "array"
        },
        "p95": {
          "items": {
            "type": "number"
          },
          "title": "P95",
          "type": "array"
        },
        "type": {
          "const": "fan_chart",
          "default": "fan_chart",
          "title": "Type",
          "type": "string"
        },
        "years": {
          "items": {
            "type": "integer"
          },
          "title": "Years",
          "type": "array"
        }
      },
      "required": [
        "years",
        "p5",
        "p25",
        "p50",
        "p75",
        "p95",
        "contributions"
      ],
      "title": "FanChartBlock",
      "type": "object"
    },
    "FilterChip": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "key",
        "label"
      ],
      "title": "FilterChip",
      "type": "object"
    },
    "HandoffAction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "HandoffAction",
      "type": "object"
    },
    "HandoffBlock": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/HandoffAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "type": {
          "const": "handoff",
          "default": "handoff",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "reason",
        "actions"
      ],
      "title": "HandoffBlock",
      "type": "object"
    },
    "MarketEvent": {
      "additionalProperties": false,
      "description": "Ground truth for attribution: a dated shock to the whole market or to single sectors.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "duration_days": {
          "minimum": 1,
          "title": "Duration Days",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sectors": {
          "description": "Empty list = whole market",
          "items": {
            "type": "string"
          },
          "title": "Sectors",
          "type": "array"
        },
        "shock_pct": {
          "title": "Shock Pct",
          "type": "number"
        }
      },
      "required": [
        "id",
        "date",
        "name",
        "description",
        "sectors",
        "shock_pct",
        "duration_days"
      ],
      "title": "MarketEvent",
      "type": "object"
    },
    "OverlapMatrixBlock": {
      "additionalProperties": false,
      "properties": {
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "products": {
          "items": {
            "$ref": "#/$defs/OverlapProduct"
          },
          "title": "Products",
          "type": "array"
        },
        "type": {
          "const": "overlap_matrix",
          "default": "overlap_matrix",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "products",
        "matrix"
      ],
      "title": "OverlapMatrixBlock",
      "type": "object"
    },
    "OverlapProduct": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "name"
      ],
      "title": "OverlapProduct",
      "type": "object"
    },
    "ProductCardsBlock": {
      "additionalProperties": false,
      "properties": {
        "filters": {
          "description": "'Das habe ich verstanden' chips",
          "items": {
            "$ref": "#/$defs/FilterChip"
          },
          "title": "Filters",
          "type": "array"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ScreenItem"
          },
          "title": "Items",
          "type": "array"
        },
        "total_matches": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Matches"
        },
        "type": {
          "const": "product_cards",
          "default": "product_cards",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "items"
      ],
      "title": "ProductCardsBlock",
      "type": "object"
    },
    "RiskMeterBlock": {
      "additionalProperties": false,
      "properties": {
        "sri": {
          "maximum": 7,
          "minimum": 1,
          "title": "Sri",
          "type": "integer"
        },
        "type": {
          "const": "risk_meter",
          "default": "risk_meter",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "sri"
      ],
      "title": "RiskMeterBlock",
      "type": "object"
    },
    "ScreenItem": {
      "additionalProperties": false,
      "properties": {
        "asset_class": {
          "enum": [
            "equity_etf",
            "equity_fund",
            "bond_fund",
            "mixed_fund",
            "money_market"
          ],
          "title": "Asset Class",
          "type": "string"
        },
        "distribution": {
          "enum": [
            "thesaurierend",
            "ausschüttend"
          ],
          "title": "Distribution",
          "type": "string"
        },
        "isin": {
          "title": "Isin",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "region": {
          "enum": [
            "Europa",
            "USA",
            "Welt",
            "Schwellenländer",
            "Österreich"
          ],
          "title": "Region",
          "type": "string"
        },
        "savings_plan_min_eur": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Savings Plan Min Eur"
        },
        "sfdr": {
          "enum": [
            6,
            8,
            9
          ],
          "title": "Sfdr",
          "type": "integer"
        },
        "sri": {
          "maximum": 7,
          "minimum": 1,
          "title": "Sri",
          "type": "integer"
        },
        "ter": {
          "title": "Ter",
          "type": "number"
        },
        "why_matched": {
          "items": {
            "type": "string"
          },
          "title": "Why Matched",
          "type": "array"
        }
      },
      "required": [
        "product_id",
        "name",
        "isin",
        "asset_class",
        "region",
        "sfdr",
        "sri",
        "ter",
        "distribution",
        "savings_plan_min_eur",
        "why_matched"
      ],
      "title": "ScreenItem",
      "type": "object"
    },
    "SuitabilityBlock": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "$ref": "#/$defs/SuitabilityReason"
          },
          "title": "Reasons",
          "type": "array"
        },
        "type": {
          "const": "suitability",
          "default": "suitability",
          "title": "Type",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "verdict",
        "reasons"
      ],
      "title": "SuitabilityBlock",
      "type": "object"
    },
    "SuitabilityReason": {
      "additionalProperties": false,
      "properties": {
        "profile_field": {
          "title": "Profile Field",
          "type": "string"
        },
        "rule": {
          "enum": [
            "risk",
            "knowledge",
            "experience",
            "horizon",
            "sustainability"
          ],
          "title": "Rule",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "status",
        "text",
        "profile_field"
      ],
      "title": "SuitabilityReason",
      "type": "object"
    },
    "TextBlock": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "description": "Chunk IDs cited in the text",
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "markdown": {
          "title": "Markdown",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "markdown"
      ],
      "title": "TextBlock",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "attribution": "#/$defs/AttributionBlock",
      "citations": "#/$defs/CitationsBlock",
      "cost_breakdown": "#/$defs/CostBreakdownBlock",
      "exposure_bars": "#/$defs/ExposureBarsBlock",
      "fan_chart": "#/$defs/FanChartBlock",
      "handoff": "#/$defs/HandoffBlock",
      "overlap_matrix": "#/$defs/OverlapMatrixBlock",
      "product_cards": "#/$defs/ProductCardsBlock",
      "risk_meter": "#/$defs/RiskMeterBlock",
      "suitability": "#/$defs/SuitabilityBlock",
      "text": "#/$defs/TextBlock"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TextBlock"
    },
    {
      "$ref": "#/$defs/ProductCardsBlock"
    },
    {
      "$ref": "#/$defs/RiskMeterBlock"
    },
    {
      "$ref": "#/$defs/FanChartBlock"
    },
    {
      "$ref": "#/$defs/ExposureBarsBlock"
    },
    {
      "$ref": "#/$defs/OverlapMatrixBlock"
    },
    {
      "$ref": "#/$defs/AttributionBlock"
    },
    {
      "$ref": "#/$defs/CostBreakdownBlock"
    },
    {
      "$ref": "#/$defs/SuitabilityBlock"
    },
    {
      "$ref": "#/$defs/HandoffBlock"
    },
    {
      "$ref": "#/$defs/CitationsBlock"
    }
  ]
}
