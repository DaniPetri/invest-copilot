    "ScreenFilter": {
      "additionalProperties": false,
      "properties": {
        "asset_classes": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "equity_etf",
                  "equity_fund",
                  "bond_fund",
                  "mixed_fund",
                  "money_market"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Asset Classes"
        },
        "distribution": {
          "anyOf": [
            {
              "enum": [
                "thesaurierend",
                "ausschüttend"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution"
        },
        "exclusions": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "Waffen",
                  "Fossile",
                  "Tabak",
                  "Glücksspiel"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusions"
        },
        "max_sri": {
          "anyOf": [
            {
              "maximum": 7,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Sri"
        },
        "max_ter": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Ter"
        },
        "regions": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "Europa",
                  "USA",
                  "Welt",
                  "Schwellenländer",
                  "Österreich"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regions"
        },
        "savings_plan": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Savings Plan"
        },
        "sfdr_min": {
          "anyOf": [
            {
              "enum": [
                6,
                8,
                9
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sfdr Min"
        }
      },
      "title": "ScreenFilter",
      "type": "object"
    },
    "ScreenInput": {
      "additionalProperties": false,
      "properties": {
        "filter": {
          "$ref": "#/$defs/ScreenFilter"
