    "MarketEvent": {
      "additionalProperties": false,
      "description": "Ground truth for attribution: a dated shock to the whole market or to single sectors.",
      "properties": {
        "date": {
          "format": "date",
          "title": "Date",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "duration_days": {
          "minimum": 1,
          "title": "Duration Days",
          "type": "integer"
        },
