          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "sectors": {
          "description": "Empty list = whole market",
          "items": {
            "type": "string"
          },
          "title": "Sectors",
          "type": "array"
        },
        "shock_pct": {
          "title": "Shock Pct",
          "type": "number"
        }
