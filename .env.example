# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# live | record | replay  (replay needs no key)
LLM_MODE=replay
ROUTER_MODEL=claude-haiku-4-5-20251001
ORCHESTRATOR_MODEL=claude-sonnet-5
JUDGE_MODEL=claude-opus-5
# 1 = use the multilingual cross-encoder reranker (downloads ~1.1 GB once)
RERANK=0
# fail (default) = an ungrounded number triggers the repair round, then the safe fallback; flag = trace only
NUMBERS_GUARD=fail
VITE_BRAND_NAME=Invest Copilot
